# ==============================================================================
# Tunable parameters — edit these, then run: docker compose up --build
# ==============================================================================

# --- Frame rate & resolution ---
TARGET_FPS=60          # Output frame rate. minterpolate generates real in-between
                        # frames (not just duplicates) using motion estimation.
UPSCALE_FACTOR=2        # 2 = double width & height (e.g. 480p -> 960p). Use 1 to
                        # skip upscaling and only denoise/stabilize/interpolate.

# --- Encode quality ---
CRF=18                  # Quality: 0=lossless, 51=worst. 16-20 is visually
                        # near-lossless. Lower = bigger file, better quality.
PRESET=slow             # ultrafast, fast, medium, slow, veryslow.
                        # Slower = better compression at the same CRF, but takes
                        # longer. Use "medium" if you want faster runs.
THREADS=0               # 0 = auto-detect all CPU cores.

# --- Denoise (kills WhatsApp compression grain) ---
DENOISE_LUMA_SPATIAL=4
DENOISE_CHROMA_SPATIAL=3
DENOISE_LUMA_TMP=6       # Temporal denoise strength — this is what removes the
DENOISE_CHROMA_TMP=4.5   # "flickering grain" look across frames. Raise for
                         # grainier source footage, but too high can smear motion.

# --- Sharpen (applied after upscaling to recover perceived detail) ---
SHARPEN_AMOUNT=0.8       # ~0.5 (subtle) to ~1.5 (strong). Too high looks artificial.

# --- Deshake (two-pass stabilization) ---
DESHAKE_ENABLED=true
DESHAKE_SHAKINESS=5      # 1 (barely shaky) to 10 (very shaky handheld footage)
DESHAKE_ACCURACY=15      # 1-15, higher = more accurate motion analysis, slower
DESHAKE_SMOOTHING=10     # Higher = smoother camera path, but more edge cropping
DESHAKE_ZOOM=5           # Slight zoom-in (%) to hide black borders stabilization
                         # can introduce at the frame edges

# --- Frame interpolation quality ---
MI_MODE=mci              # mci = real motion-compensated interpolation (best
                         # quality, slower). Alternatives: blend, dup (faster,
                         # much lower quality — avoid unless mci is too slow).

# --- Audio ---
AUDIO_BITRATE=192k

# --- Output ---
OUTPUT_SUFFIX=_enhanced   # Appended to each filename in /output
